<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.alaugks</groupId>
        <artifactId>parent</artifactId>
        <version>1.0.0</version>
        <relativePath/>
    </parent>

    <artifactId>aws-app-instance-id</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>aws-app-instance-id</name>
    <description>Provides a unique instance ID for applications running on AWS Elastic Beanstalk or AWS Fargate.</description>
    <url>https://github.com/alaugks/aws-app-instance-id</url>

    <developers>
        <developer>
            <name>André Laugks</name>
            <email>alaugks@gmail.com</email>
            <url>https://github.com/alaugks</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/alaugks/aws-app-instance-id.git</connection>
        <developerConnection>scm:git:git@github.com:alaugks/aws-app-instance-id.git</developerConnection>
        <url>https://github.com/alaugks/aws-app-instance-id</url>
    </scm>

    <properties>
        <junit.version>5.12.2</junit.version>
        <mockito.version>5.17.0</mockito.version>
        <assertj.version>3.27.6</assertj.version>
    </properties>

    <dependencies>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <ECS_CONTAINER_METADATA_URI_V4>http://169.254.170.2/v4/test</ECS_CONTAINER_METADATA_URI_V4>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
